<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:paddingBottom="@dimen/_4sdp"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/noty_layout"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_39sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:id="@+id/imageView76"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="fitXY"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0"
            app:srcCompat="@drawable/noty_text_bg"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/cardView7"
            android:layout_width="@dimen/_39sdp"
            android:layout_height="@dimen/_39sdp"
            app:cardBackgroundColor="#ff181819"
            app:cardCornerRadius="@dimen/_5sdp"
            app:cardElevation="0dp"
            app:cardMaxElevation="0dp"
            app:cardPreventCornerOverlap="false"
            app:cardUseCompatPadding="false"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/_1sdp"
                android:layout_marginBottom="@dimen/_1sdp"
                android:layout_marginStart="@dimen/_1sdp"
                android:layout_marginEnd="@dimen/_1sdp"
                app:cardBackgroundColor="#ff181819"
                app:cardCornerRadius="@dimen/_4sdp"
                app:cardElevation="0dp"
                app:cardMaxElevation="0dp"
                app:cardPreventCornerOverlap="false"
                app:cardUseCompatPadding="false"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/noty_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:srcCompat="@drawable/noty_green_icon"/>
        </androidx.cardview.widget.CardView>
        <TextView
            android:textSize="@dimen/_9sdp"
            android:textColor="#ffffffff"
            android:id="@+id/noty_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Продаю сыр\10Стоимость: 200 000р"
            android:maxLines="3"
            android:fontFamily="@font/akrobat_bold"
            android:paddingEnd="@dimen/_18sdp"
            android:layout_marginStart="@dimen/_14sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/cardView7"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:id="@+id/noty_btn_1"
            android:layout_width="@dimen/_77sdp"
            android:layout_height="@dimen/_25sdp"
            android:layout_marginEnd="@dimen/_6sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/noty_btn_2"
            app:layout_constraintStart_toEndOf="@+id/noty_text"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/noty_btn_bg_1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                app:srcCompat="@drawable/noty_true_btn"/>
            <TextView
                android:textSize="@dimen/_9sdp"
                android:textColor="#ffffffff"
                android:layout_gravity="center"
                android:id="@+id/noty_btn_text_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Кнопка"
                android:textAllCaps="true"
                android:fontFamily="@font/akrobat_extrabold"/>
        </FrameLayout>
        <FrameLayout
            android:id="@+id/noty_btn_2"
            android:layout_width="@dimen/_77sdp"
            android:layout_height="@dimen/_25sdp"
            android:layout_marginEnd="@dimen/_6sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/noty_btn_1"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/noty_btn_bg_2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                app:srcCompat="@drawable/noty_false_btn"/>
            <TextView
                android:textSize="@dimen/_9sdp"
                android:textColor="#ffffffff"
                android:layout_gravity="center"
                android:id="@+id/noty_btn_text_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Кнопка"
                android:textAllCaps="true"
                android:fontFamily="@font/akrobat_extrabold"/>
        </FrameLayout>
        <ProgressBar
            android:id="@+id/noty_progress"
            android:visibility="visible"
            android:layout_width="0dp"
            android:layout_height="@dimen/_1sdp"
            android:max="1000"
            android:progress="1000"
            android:indeterminate="false"
            android:progressDrawable="@drawable/progressbar_noty"
            android:layout_marginStart="@dimen/_2sdp"
            android:layout_marginEnd="@dimen/_3sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            style="?android:attr/progressBarStyleHorizontal"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
