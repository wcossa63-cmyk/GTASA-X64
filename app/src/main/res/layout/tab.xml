<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tab"
    android:background="@drawable/tab_bg"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/exit_button"
        android:background="@drawable/auth_back_button_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.1259"
        app:layout_constraintLeft_toRightOf="@+id/left_line"
        app:layout_constraintTop_toBottomOf="@+id/top_line"
        app:layout_constraintWidth_percent="0.1437">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/left_back_button_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.1718"/>
        <ImageView
            android:id="@+id/back_button_ic"
            android:layout_width="@dimen/_18sdp"
            android:layout_height="@dimen/_18sdp"
            android:src="@drawable/auth_back_button_ic"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/left_back_button_line"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/_10sdp"
            android:textColor="#ffffff"
            android:id="@+id/back_button_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/_8sdp"
            android:text="выйти"
            android:textAllCaps="true"
            android:fontFamily="@font/akrobat_bold"
            app:layout_constraintBottom_toBottomOf="@+id/back_button_ic"
            app:layout_constraintLeft_toRightOf="@+id/back_button_ic"
            app:layout_constraintTop_toTopOf="@+id/back_button_ic"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="@dimen/_17sdp"
        android:textColor="#ffffff"
        android:id="@+id/gamers_list_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="СПИСОК ИГРОКОВ"
        android:textAllCaps="true"
        android:fontFamily="@font/akrobat_extra_bold"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/exit_button"/>
    <TextView
        android:textSize="@dimen/_9sdp"
        android:textColor="#70ffffff"
        android:id="@+id/gamers_list_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Light Mobile"
        android:textAllCaps="true"
        android:fontFamily="@font/akrobat_extra_bold"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gamers_list_title"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/tab_search_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/exit_button"
        app:layout_constraintHeight_percent="0.0888"
        app:layout_constraintRight_toLeftOf="@+id/right_line"
        app:layout_constraintTop_toTopOf="@+id/exit_button"
        app:layout_constraintWidth_percent="0.226">
        <ImageView
            android:id="@+id/search_ic"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginLeft="@dimen/_8sdp"
            android:src="@drawable/tab_search_ic"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHeight_percent="0.4166"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.0921"/>
        <EditText
            android:textSize="@dimen/_9sdp"
            android:textColor="#ffffff"
            android:textColorHint="#a3a6a9"
            android:id="@+id/search_text_edit"
            android:background="@android:color/transparent"
            android:paddingTop="@dimen/_6sdp"
            android:paddingBottom="@dimen/_7sdp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Поиск по никнейму"
            android:maxLines="1"
            android:lines="1"
            android:singleLine="true"
            android:inputType="text"
            android:imeOptions="flagNoExtractUi|flagNoFullscreen|actionDone"
            android:fontFamily="@font/akrobat_bold"
            android:paddingStart="@dimen/_5sdp"
            android:paddingEnd="@dimen/_6sdp"
            android:elevation="@dimen/_7sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/search_ic"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/user_titles_container"
        android:background="@drawable/tab_titles_container_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/_12sdp"
        app:layout_constraintHeight_percent="0.0888"
        app:layout_constraintLeft_toRightOf="@+id/left_line"
        app:layout_constraintRight_toLeftOf="@+id/right_line"
        app:layout_constraintTop_toBottomOf="@+id/exit_button">
        <TextView
            android:textSize="@dimen/_9sdp"
            android:textColor="#ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Id игрока"
            android:fontFamily="@font/akrobat_bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/first_title_right_line"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/_9sdp"
            android:textColor="#ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Имя персонажа"
            android:fontFamily="@font/akrobat_bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/first_title_right_line"
            app:layout_constraintRight_toLeftOf="@+id/second_title_right_line"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/_9sdp"
            android:textColor="#ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Уровень"
            android:fontFamily="@font/akrobat_bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/second_title_right_line"
            app:layout_constraintRight_toLeftOf="@+id/third_title_right_line"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/_9sdp"
            android:textColor="#ffffff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Пинг"
            android:fontFamily="@font/akrobat_bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/third_title_right_line"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/first_title_right_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.249"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/second_title_right_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.498"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/third_title_right_line"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.749"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:scrollbarThumbVertical="@drawable/tab_thumb"
        android:scrollbarTrackVertical="@drawable/tab_track"
        android:scrollbarStyle="insideOverlay"
        android:orientation="vertical"
        android:id="@+id/users_rc"
        android:visibility="visible"
        android:scrollbars="vertical"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scrollbarFadeDuration="300"
        android:fadeScrollbars="false"
        android:verticalScrollbarPosition="left"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="@+id/user_titles_container"
        app:layout_constraintRight_toRightOf="@+id/user_titles_container"
        app:layout_constraintTop_toBottomOf="@+id/user_titles_container"
        app:spanCount="1"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/left_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.0432"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/right_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.9567"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/top_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.0787"/>
</androidx.constraintlayout.widget.ConstraintLayout>
